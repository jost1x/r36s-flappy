# Build against Debian Buster's glibc 2.28 so the ARM64 executable remains
# compatible with the older userspace shipped by ArkOS on the R36S.
FROM --platform=$BUILDPLATFORM debian:buster AS build

RUN sed -i \
        -e 's|^# deb http://snapshot.debian.org|deb http://snapshot.debian.org|' \
        -e 's|^deb http://deb.debian.org|# deb http://deb.debian.org|' \
        /etc/apt/sources.list \
    && dpkg --add-architecture arm64 \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        cmake \
        g++-aarch64-linux-gnu \
        git \
        libdrm-dev:arm64 \
        libgbm-dev:arm64 \
        libc6-dev-arm64-cross \
        libegl1-mesa-dev:arm64 \
        libgles2-mesa-dev:arm64 \
        make \
        pkg-config \
        python3 \
    && rm -rf /var/lib/apt/lists/*

ARG RAYLIB_VERSION=5.5
ARG RAYGUI_VERSION=4.0
RUN git clone --depth 1 --branch "$RAYLIB_VERSION" https://github.com/raysan5/raylib.git /opt/raylib \
    && git clone --depth 1 --branch "$RAYGUI_VERSION" https://github.com/raysan5/raygui.git /opt/raygui \
    && cmake -S /opt/raylib -B /tmp/raylib-build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_SYSTEM_NAME=Linux \
        -DCMAKE_SYSTEM_PROCESSOR=aarch64 \
        -DCMAKE_C_COMPILER=aarch64-linux-gnu-gcc \
        -DCMAKE_CXX_COMPILER=aarch64-linux-gnu-g++ \
        -DCMAKE_INSTALL_PREFIX=/opt/raylib-install \
        -DBUILD_EXAMPLES=OFF \
        -DPLATFORM=DRM \
    && cmake --build /tmp/raylib-build --parallel 2 \
    && cmake --install /tmp/raylib-build

WORKDIR /src
COPY CMakeLists.txt ./
COPY include ./include
COPY src ./src
COPY assets ./assets
COPY scripts ./scripts

RUN cmake -S . -B /tmp/app-build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_SYSTEM_NAME=Linux \
        -DCMAKE_SYSTEM_PROCESSOR=aarch64 \
        -DCMAKE_C_COMPILER=aarch64-linux-gnu-gcc \
        -DCMAKE_CXX_COMPILER=aarch64-linux-gnu-g++ \
        -DR36S_DRM=ON \
        -DEMBED_ASSETS=ON \
        -DBUILD_TESTING=OFF \
    && cmake --build /tmp/app-build --parallel 2 \
    && install -D /tmp/app-build/r36s-flappy /out/r36s-flappy

FROM scratch
COPY --from=build /out/r36s-flappy /r36s-flappy
