.PHONY: all build debug release clean install deploy hooks pre-commit format lint test verify help

NATIVE_ARCH := $(shell uname -m)
BUILD_BIN := build/r36s-flappy
CPP_SOURCES := $(shell find src -name '*.cpp' -o -name '*.h' | sort)

help:
	@echo "R36S Flappy Bird - Build Targets"
	@echo "============================"
	@echo "make build      - Compilación local (debug)"
	@echo "make release    - Compilación optimizada"
	@echo "make arm64      - Compilación cruzada para R36S (ARM64)"
	@echo "make clean      - Limpiar directorios de compilación"
	@echo "make run        - Ejecutar localmente"
	@echo "make deploy     - Desplegar a R36S por SSH"
	@echo "make install    - Instalar dependencias"

install:
	@echo "Instalando dependencias..."
	sudo apt update
	sudo apt install -y build-essential cmake git libsdl2-dev libegl1-mesa-dev libwayland-dev libx11-dev libxext-dev libxft-dev libxkbcommon-dev

hooks:
	@git config core.hooksPath .githooks
	@echo "✓ Hooks de Git activados para este repositorio"

pre-commit:
	@.githooks/pre-commit

format:
	@clang-format --dry-run --Werror $(CPP_SOURCES)

lint:
	@cmake -S . -B build -DBUILD_TESTING=ON -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
	@clang-tidy -p build --warnings-as-errors='*' $(CPP_SOURCES)

test:
	@cmake -S . -B build -DBUILD_TESTING=ON -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
	@cmake --build build -j$$(nproc)
	@ctest --test-dir build --output-on-failure

verify: format lint test

build:
	@echo "Compilando (Debug)..."
	@mkdir -p build
	@cd build && cmake .. -DCMAKE_BUILD_TYPE=Debug && cmake --build .
	@echo "✓ Compilación completada: ./$(BUILD_BIN)"

debug: build

release:
	@echo "Compilando (Release)..."
	@mkdir -p build
	@cd build && cmake .. -DCMAKE_BUILD_TYPE=Release && cmake --build .
	@echo "✓ Compilación completada: ./$(BUILD_BIN)"

arm64:
	@bash build-r36s.sh

clean:
	@echo "Limpiando..."
	@rm -rf build
	@rm -rf bin/r36s-arm64

run: build
	@echo "Ejecutando..."
	@if [ "$$XDG_SESSION_TYPE" = "wayland" ]; then \
		SDL_VIDEODRIVER=wayland ./$(BUILD_BIN); \
	else \
		./$(BUILD_BIN); \
	fi

deploy: arm64
	@bash deploy-r36s.sh

watch:
	@while true; do \
		clear; \
		make build; \
		inotifywait -r -e modify src/ include/; \
	done
